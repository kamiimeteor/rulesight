{
  "name": "rulesight",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "adapt": "node scripts/adapt.ts",
    "check": "node scripts/check-steps.ts",
    "judge": "node scripts/judge.ts",
    "check:verdicts": "node scripts/check-verdicts.ts",
    "typecheck": "tsc --noEmit && tsc -p report/tsconfig.json --noEmit",
    "build:report": "vite build --config report/vite.config.ts",
    "report": "node scripts/report.ts",
    "build:plugin": "npm run build:report && node scripts/build-plugin.ts",
    "test": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
